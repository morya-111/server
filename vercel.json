{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm i -g typescript@4.5.3 && yarn install --production=false",
  "buildCommand": "yarn build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "regions": [
    "bom1"
  ]
}
