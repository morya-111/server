PORT?=4000
NODE_ENV=development
LATENCY?=
# Supabase → Connect → Session pooler URI (IPv4-safe)
DATABASE_URL=
# Supabase project URL + keys (Storage uploads, Realtime chat)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET?=images
# Set true only to let the app create/alter tables on boot (default: on in dev, off in prod)
DB_SYNC?=
JWT_SECRET=
JWT_EXPIRES_IN=7
JWT_COOKIE_EXPIRES_IN=7
# Optional: OAuth is disabled unless both id + secret are set
GOOGLE_CLIENT_ID?=
GOOGLE_CLIENT_SECRET?=
FACEBOOK_APP_ID?=
FACEBOOK_APP_SECRET?=
FRONTEND_CLIENT=http://localhost:3000
FAILURE_ROUTE?=
SUCCESS_ROUTE?=
TEST_DATABASE_URL?=(Only For Test)
